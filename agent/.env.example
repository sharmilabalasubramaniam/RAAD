# Backend Connection (Production Render or Local FastAPI Backend)
RAAD_BACKEND_URL="https://raad-5iv8.onrender.com"
BACKEND_URL="https://raad-5iv8.onrender.com/api/v1"

# Google Gemini API Configuration (Leave empty to use zero-latency local rules dispatcher)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
GEMINI_MODEL="gemini-2.5-flash"

# Render Service Configuration
PORT=8001
AGENT_PORT=8001
AGENT_HOST="0.0.0.0"
TIMEOUT_SECONDS=15.0
